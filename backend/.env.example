# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=finguard_db

# ---- Auth ----
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- App ----
ENV=development
CORS_ORIGINS=http://localhost:5173

# ---- OTP (simulated provider for hackathon demo) ----
# In a real deployment this would be Termii / Twilio / AWS SNS etc.
OTP_DEMO_MODE=true
OTP_EXPIRE_SECONDS=300

# ---- Fraud Engine ----
FRAUD_RULE_VERSION=1.0.0
